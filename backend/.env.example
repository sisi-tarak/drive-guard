# Gemini AI (for text search query enhancement)
GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone vector database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=driveguard

# Google OAuth paths (relative to where uvicorn is run from)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.pickle

# OAuth redirect must match a URI registered in Google Cloud Console
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Frontend URL for post-login redirect
FRONTEND_URL=http://localhost:5173
